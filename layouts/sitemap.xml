{{ "<?" | safeHTML }}xml-stylesheet type="text/xsl" href="{{ "sitemap.xsl" | relURL }}"{{ "?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{ range .Data.Pages }}
  {{- if not (or .Params.hidden .Params.private .Params.noindex (and (isset .Params "robots") (findRE `(?i)noindex` .Params.robots))) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.UTC.Format "2006-01-02T15:04:05Z0700" )  }}</lastmod>{{ end }}
  </url>
  {{- end }}
  {{ end }}
</urlset>
