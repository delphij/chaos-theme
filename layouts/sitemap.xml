{{- /* Pages the site redirects away (site.Params.redirects) are kept out of the
       sitemap: their content lives at the redirect target. */ -}}
{{- $redirected := slice -}}
{{- range site.Params.redirects -}}
  {{- with index . "from" -}}
    {{- $redirected = $redirected | append . -}}
  {{- end -}}
{{- end -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{ "<?" | safeHTML }}xml-stylesheet type="text/xsl" href="{{ "sitemap.xsl" | relURL }}"{{ "?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  {{- if and .Permalink (ne .Kind "404") (not (or .Sitemap.Disable .Params.private .Params.noindex (in $redirected .RelPermalink) (and (isset .Params "robots") (findRE `(?i)noindex` .Params.robots)))) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.UTC.Format "2006-01-02T15:04:05Z") }}</lastmod>
    {{- end }}
    {{- range partial "_funcs/get-alternates.html" . }}
    <xhtml:link rel="alternate" hreflang="{{ .lang }}" href="{{ .href }}" />
    {{- end }}
  </url>
  {{- end }}
  {{ end }}
</urlset>
