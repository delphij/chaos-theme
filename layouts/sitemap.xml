{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{ "<?" | safeHTML }}xml-stylesheet type="text/xsl" href="{{ "sitemap.xsl" | relURL }}"{{ "?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{ range .Data.Pages }}
  {{- if and .Permalink (ne .Kind "404") (not (or .Params.hidden .Params.private .Params.noindex (eq .RelPermalink "/posts/") (and (isset .Params "robots") (findRE `(?i)noindex` .Params.robots)))) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML (.Lastmod.Format "2006-01-02T15:04:05-07:00") }}</lastmod>
    {{- end }}
    {{- if .IsTranslated }}
      {{- range .AllTranslations }}
    <xhtml:link rel="alternate" hreflang="{{ .Language.Lang }}" href="{{ .Permalink }}" />
      {{- end }}
      {{- with index (where .AllTranslations "Language.Lang" site.Sites.Default.Language.Lang) 0 }}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ .Permalink }}" />
      {{- end }}
    {{- end }}
  </url>
  {{- end }}
  {{ end }}
</urlset>
