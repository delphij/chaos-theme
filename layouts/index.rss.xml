{{- $pages := "" -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Type" "in" site.Params.mainSections -}}
{{- else -}}
  {{- $pages = .RegularPages -}}
{{- end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if le $limit 0 -}}
  {{- $limit = 25 -}}
{{- end -}}
{{- $pages = $pages | first $limit -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
{{ "<?" | safeHTML }}xml-stylesheet type="text/xsl" href="{{ "feed.xsl" | relURL }}"{{ "?>" | safeHTML }}
<rss version="2.0"
  xmlns:atom="http://www.w3.org/2005/Atom"
  xmlns:content="http://purl.org/rss/1.0/modules/content/"
  xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ if eq .Title site.Title }}{{ site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ if ne .Title site.Title }}{{ with .Title }}Recent content in {{ . }} on {{ site.Title }}{{ end }}{{ else }}{{ or site.Params.description site.Params.subtitle (printf "Recent content on %s" site.Title) }}{{ end }}</description>
    <generator>Hugo -- gohugo.io</generator>
    {{- with site.Language.Locale }}
    <language>{{ . }}</language>
    {{- else }}
    {{- with site.LanguageCode }}
    <language>{{ . }}</language>
    {{- end }}
    {{- end }}
    {{- with site.Copyright }}
    <copyright>{{ . | markdownify | plainify }}</copyright>
    {{- end }}
    {{- with site.Params.author.email }}
    <managingEditor>{{ . }}{{ with site.Params.author.name }} ({{ . }}){{ end }}</managingEditor>
    <webMaster>{{ . }}{{ with site.Params.author.name }} ({{ . }}){{ end }}</webMaster>
    {{- end }}
    {{- with index $pages 0 }}
      {{- if not .Date.IsZero }}
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- end }}
    {{- end }}
    {{- if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- else }}
      {{- with index $pages 0 }}
        {{- if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
        {{- end }}
      {{- end }}
    {{- end }}
    <docs>https://cyber.harvard.edu/rss/rss.html</docs>
    <ttl>60</ttl>
    {{- with site.Params.brand.logo | default site.Params.brand.icon }}
    <image>
      <url>{{ . | absURL }}</url>
      <title>{{ site.Title }}</title>
      <link>{{ site.BaseURL }}</link>
    </image>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $pages }}
      {{- if and (.IsPage) (.Params.date) }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with site.Params.author.email }}
      <author>{{ . }}{{ with site.Params.author.name }} ({{ . }}){{ end }}</author>
      {{- end }}
      <dc:creator>{{ or .Params.author site.Params.author.name site.Title }}</dc:creator>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      {{- with .Params.categories }}
        {{- range . }}
      <category>{{ . }}</category>
        {{- end }}
      {{- end }}
      {{- with .Params.tags }}
        {{- range . }}
      <category>{{ . }}</category>
        {{- end }}
      {{- end }}
      <comments>{{ .Permalink }}#comments</comments>
      <description>{{ "<![CDATA[" | safeHTML }}{{ .Summary }}{{ "]]>" | safeHTML }}</description>
      <content:encoded>{{ "<![CDATA[" | safeHTML }}{{ .Content }}{{ "]]>" | safeHTML }}</content:encoded>
    </item>
      {{- end }}
    {{- end }}
  </channel>
</rss>